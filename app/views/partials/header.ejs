<a class="pular-conteudo" href="#conteudo">Ir para o conteúdo</a>
<header class="home-header">
  <a class="home-logo" href="/" aria-label="BioClicky - página inicial">
    <span class="home-logo-marca" aria-hidden="true">+</span>BioClicky
  </a>

  <!-- A navegação principal fica na barra inferior (navegacao.ejs). Aqui ficam só os botões de ajuste. -->
  <menu class="header-acoes" aria-label="Ajustes de exibição">
    <li>
      <button class="icone-botao" id="acessBotao" type="button" aria-haspopup="dialog" aria-controls="painelAcess" aria-label="Abrir opções de acessibilidade (atalho Alt + A)">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="4.5" r="1.8"></circle>
          <path d="M4 8.5l8 1.5 8-1.5"></path>
          <path d="M12 10v4.5"></path>
          <path d="M8.5 21l3.5-6.5 3.5 6.5"></path>
        </svg>
      </button>
    </li>
    <li>
      <button class="icone-botao tema-botao" id="temaBotao" type="button" aria-pressed="false" aria-label="Modo escuro">
        <svg class="tema-icone tema-sol" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="tema-icone tema-lua" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </li>
  </menu>
</header>
<main id="conteudo" tabindex="-1">
