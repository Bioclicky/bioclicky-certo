<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="pagina-topo">
  <p><a href="/remedios">← Voltar para remédios</a></p>
  <%- include('../partials/imagem-remedio', { r: remedio }) %>
  <h1><%= remedio.nome %></h1>
  <p class="remedio-lab"><%= remedio.laboratorio %> · <%= remedio.categoria %></p>
  <p><%= remedio.descricao %></p>
  <p class="aviso-demo">Preços demonstrativos. O BioClicky não vende medicamentos.</p>
</section>

<section class="secao">
  <h2 class="secao-titulo">Comparação de preços</h2>
  <% if (ofertas.length === 0) { %>
    <p class="vazio">Nenhuma oferta disponível.</p>
  <% } else { %>
  <ol class="lista-ofertas">
    <% ofertas.forEach(function (o, i) { %>
    <li class="oferta <%= i === 0 ? 'oferta-melhor' : '' %>">
      <span class="oferta-farmacia"><%= o.farmacia %></span>
      <% if (i === 0) { %><span class="selo">Menor preço</span><% } %>
      <strong class="oferta-preco">R$ <%= o.preco.toFixed(2).replace('.', ',') %></strong>
    </li>
    <% }); %>
  </ol>
  <% } %>
</section>

<%- include('../partials/footer') %>
<%- include('../partials/fim') %>
